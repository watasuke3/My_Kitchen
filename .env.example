# ============================================================
# 環境変数テンプレート
#
# このファイルは git にコミットされる（値はダミー）。
# 実際に使う際は cp .env.example .env でコピーし、
# .env の値を環境ごとに編集する。
# .env は .gitignore で除外される。
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=my_kitchen
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_DB=my_kitchen
