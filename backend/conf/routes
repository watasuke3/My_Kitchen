# Routes
# This file defines all application routes (Higher priority routes first)
# https://www.playframework.com/documentation/latest/ScalaRouting
# ~~~~

# An example controller showing a sample home page
GET     /                           controllers.HomeController.index()

# API
GET     /api/health                 controllers.HomeController.health()

# Auth
POST    /api/v1/auth/register       controllers.AuthController.register()
POST    /api/v1/auth/login          controllers.AuthController.login()
POST    /api/v1/auth/logout         controllers.AuthController.logout()
GET     /api/v1/auth/me             controllers.AuthController.me()

# Recipes
GET     /api/v1/recipes             controllers.RecipeController.list()
POST    /api/v1/recipes             controllers.RecipeController.create()
GET     /api/v1/recipes/:id         controllers.RecipeController.show(id: Long)
PUT     /api/v1/recipes/:id         controllers.RecipeController.update(id: Long)
DELETE  /api/v1/recipes/:id         controllers.RecipeController.delete(id: Long)

# Meal Plans
GET     /api/v1/meal-plans             controllers.MealPlanController.list(from: String, to: String)
PUT     /api/v1/meal-plans             controllers.MealPlanController.assign()
PATCH   /api/v1/meal-plans/:id/status  controllers.MealPlanController.updateStatus(id: Long)
DELETE  /api/v1/meal-plans/:id         controllers.MealPlanController.delete(id: Long)

# Map static resources from the /public folder to the /assets URL path
GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)
